# Set in production to the public HTTPS address hosting CatCam.
# APP_ORIGIN=https://catcam.example.com

# Only enable when your host is a trusted reverse proxy that sets x-forwarded-for.
TRUST_PROXY=true

# Optional admin panel. Set a fresh, unique password of at least 16 characters
# in the server environment; never commit the real password.
ADMIN_USERNAME=Philip
ADMIN_PASSWORD=
# Optional persistent credential hash location; keep it outside the public webroot.
# ADMIN_CREDENTIALS_FILE=/private/path/catcam-admin-credentials.json

# Optional TURN relay. Use the relay URLs and shared secret from your TURN provider.
# Multiple URLs can be comma-separated. Do not commit the shared secret.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=3600

# Optional if the web app and signaling server have different origins.
# Set before building the frontend; the signaling server must allow the app origin.
VITE_SIGNALING_URL=
